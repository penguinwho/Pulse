<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/collectionRow" android:layout_width="match_parent" android:layout_height="72dp" android:layout_marginVertical="3dp" android:background="@drawable/bg_glass_row" android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="10dp" android:paddingVertical="8dp">
    <ImageView android:id="@+id/collectionArtwork" android:layout_width="52dp" android:layout_height="52dp" android:background="@drawable/bg_artwork" android:clipToOutline="true" android:contentDescription="Collection artwork" android:scaleType="centerCrop" android:src="@drawable/ic_album" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/collectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@color/pulse_ink" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/collectionDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:ellipsize="end" android:maxLines="1" android:textColor="@color/pulse_muted" android:textSize="13sp" />
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/pulse_muted" android:textSize="28sp" />
</LinearLayout>
