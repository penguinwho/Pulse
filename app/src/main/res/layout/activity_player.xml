<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/playerRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#0A080D">
    <ImageView android:id="@+id/backgroundArtwork" android:layout_width="match_parent" android:layout_height="match_parent" android:alpha="0.46" android:contentDescription="" android:scaleType="centerCrop" android:src="@drawable/ic_album" />
    <View android:id="@+id/playerScrim" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_player_scrim" />
    <LinearLayout android:id="@+id/playerContent" android:layout_width="match_parent" android:layout_height="match_parent" android:animateLayoutChanges="true" android:orientation="vertical" android:padding="20dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageButton android:id="@+id/close" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Close player" android:src="@android:drawable/ic_menu_close_clear_cancel" android:tint="#FFFFFFFF" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="NOW PLAYING" android:textColor="#DDFFFFFF" android:textSize="12sp" android:textStyle="bold" />
            <ImageButton android:id="@+id/shareSong" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Share song" android:padding="12dp" android:src="@drawable/ic_share" />
        </LinearLayout>
        <FrameLayout android:id="@+id/artworkContainer" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="14dp" android:layout_weight="4" android:elevation="8dp">
            <ImageView android:id="@+id/artwork" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_artwork_large" android:clipToOutline="true" android:contentDescription="Album artwork" android:scaleType="centerCrop" android:src="@drawable/ic_album" />
        </FrameLayout>
        <ScrollView android:id="@+id/lyricsPanel" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="14dp" android:layout_weight="4" android:clipToPadding="false" android:fadeScrollbars="false" android:fillViewport="true" android:scrollbars="none" android:visibility="gone">
            <TextView android:id="@+id/inlineLyrics" android:layout_width="match_parent" android:layout_height="wrap_content" android:lineSpacingExtra="14dp" android:paddingLeft="12dp" android:paddingTop="96dp" android:paddingRight="12dp" android:paddingBottom="128dp" android:textColor="#CCFFFFFF" android:textSize="23sp" />
        </ScrollView>
        <TextView android:id="@+id/songTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:ellipsize="end" android:maxLines="1" android:text="Nothing playing" android:textColor="#FFFFFFFF" android:textSize="23sp" android:textStyle="bold" />
        <TextView android:id="@+id/songArtist" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:ellipsize="end" android:maxLines="1" android:text="Choose a song from your library" android:textColor="#CCFFFFFF" android:textSize="15sp" />
        <SeekBar android:id="@+id/progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:progressTint="#FFFFFFFF" android:thumbTint="#FFFFFFFF" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><TextView android:id="@+id/currentTime" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="0:00" android:textColor="#CCFFFFFF" android:textSize="12sp" /><TextView android:id="@+id/totalTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0:00" android:textColor="#CCFFFFFF" android:textSize="12sp" /></LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="76dp" android:gravity="center" android:orientation="horizontal">
            <ImageButton android:id="@+id/shuffle" android:layout_width="40dp" android:layout_height="52dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Shuffle off" android:src="@drawable/ic_shuffle" android:tint="#DDFFFFFF" />
            <ImageButton android:id="@+id/previous" android:layout_width="58dp" android:layout_height="58dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Previous song" android:src="@android:drawable/ic_media_previous" android:tint="#FFFFFFFF" />
            <ImageButton android:id="@+id/playPause" android:layout_width="72dp" android:layout_height="72dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Play" android:src="@android:drawable/ic_media_play" android:tint="#FFFFFFFF" />
            <ImageButton android:id="@+id/next" android:layout_width="58dp" android:layout_height="58dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Next song" android:src="@android:drawable/ic_media_next" android:tint="#FFFFFFFF" />
            <ImageButton android:id="@+id/repeat" android:layout_width="40dp" android:layout_height="52dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Repeat off" android:src="@drawable/ic_repeat" android:tint="#DDFFFFFF" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageButton android:id="@+id/lyrics" android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/bg_player_glass_icon" android:contentDescription="Show lyrics" android:padding="7dp" android:src="@drawable/ic_lyrics" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
