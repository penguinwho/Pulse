<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_glass_backdrop">

    <ImageView
        android:id="@+id/mainBackgroundArtwork"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.20"
        android:contentDescription=""
        android:scaleType="centerCrop" />

    <View
        android:id="@+id/mainGlassOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_glass_backdrop" />

    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="Pulse"
            android:src="@drawable/logo_mark" />
        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Pulse"
            android:textColor="@color/pulse_ink"
            android:textSize="32sp"
            android:textStyle="bold" />
        <ImageButton
            android:id="@+id/settings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Open settings"
            android:src="@drawable/ic_settings_gear" />
    </LinearLayout>

    <TextView
        android:id="@+id/librarySubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Your music, uninterrupted."
        android:textColor="@color/pulse_muted"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <EditText
            android:id="@+id/search"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_glass_surface"
            android:hint="Search your library"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:paddingHorizontal="18dp"
            android:singleLine="true"
            android:textColor="@color/pulse_ink"
            android:textColorHint="@color/pulse_muted" />
        <ImageButton
            android:id="@+id/filter"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_glass_surface"
            android:contentDescription="Filter music source"
            android:src="@drawable/ic_filter" />
    </LinearLayout>

    <TextView
        android:id="@+id/songsLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="SONGS"
        android:textColor="@color/pulse_lilac"
        android:textSize="12sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/songs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />
        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">
            <ImageView
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:src="@drawable/ic_album" />
            <TextView
                android:id="@+id/emptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="No songs found"
                android:textColor="@color/pulse_ink"
                android:textSize="19sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/emptyText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Allow access to your music to start listening."
                android:textColor="@color/pulse_muted"
                android:textSize="14sp" />
            <Button
                android:id="@+id/grantAccess"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Allow music access" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/nowPlaying"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_glass_surface"
        android:gravity="center_vertical"
        android:minHeight="88dp"
        android:orientation="horizontal"
        android:padding="12dp">
        <ImageView
            android:id="@+id/nowArtwork"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/bg_artwork"
            android:clipToOutline="true"
            android:contentDescription="Album artwork"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_album" />
        <LinearLayout
            android:id="@+id/nowPlayingInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/nowTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Nothing playing"
                android:textColor="@color/pulse_ink"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/nowArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Choose a song from your library"
                android:textColor="@color/pulse_muted"
                android:textSize="13sp" />
        </LinearLayout>
        <ImageButton
            android:id="@+id/previous"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Previous song"
            android:src="@android:drawable/ic_media_previous" />
        <ImageButton
            android:id="@+id/playPause"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Play"
            android:src="@android:drawable/ic_media_play" />
        <ImageButton
            android:id="@+id/next"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Next song"
            android:src="@android:drawable/ic_media_next" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navigation"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@drawable/bg_glass_navigation"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="6dp">
        <LinearLayout
            android:id="@+id/navSongs"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_navigation_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:duplicateParentState="true"
                android:src="@drawable/ic_nav_songs"
                android:tint="@color/navigation_item_tint" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:duplicateParentState="true"
                android:text="Songs"
                android:textColor="@color/navigation_item_tint"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/navAlbums"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_navigation_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:duplicateParentState="true"
                android:src="@drawable/ic_nav_albums"
                android:tint="@color/navigation_item_tint" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:duplicateParentState="true"
                android:text="Albums"
                android:textColor="@color/navigation_item_tint"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/navArtists"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_navigation_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:duplicateParentState="true"
                android:src="@drawable/ic_nav_artists"
                android:tint="@color/navigation_item_tint" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:duplicateParentState="true"
                android:text="Artists"
                android:textColor="@color/navigation_item_tint"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
    </LinearLayout>
</FrameLayout>
