<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_glass_backdrop">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageButton
                android:id="@+id/back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:src="@android:drawable/ic_media_previous" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Settings"
                android:textColor="@color/pulse_ink"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="APPEARANCE"
            android:textColor="@color/pulse_lilac"
            android:textSize="12sp"
            android:textStyle="bold" />
        <RadioGroup
            android:id="@+id/themeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">
            <RadioButton android:id="@+id/themeSystem" android:layout_width="match_parent" android:layout_height="48dp" android:text="Use device theme" android:textColor="@color/pulse_ink" />
            <RadioButton android:id="@+id/themeLight" android:layout_width="match_parent" android:layout_height="48dp" android:text="Light" android:textColor="@color/pulse_ink" />
            <RadioButton android:id="@+id/themeDark" android:layout_width="match_parent" android:layout_height="48dp" android:text="Dark" android:textColor="@color/pulse_ink" />
        </RadioGroup>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="GLASS COLOR"
            android:textColor="@color/pulse_lilac"
            android:textSize="12sp"
            android:textStyle="bold" />
        <RadioGroup
            android:id="@+id/accentGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">
            <RadioButton android:id="@+id/accentAmethyst" android:layout_width="match_parent" android:layout_height="48dp" android:text="Amethyst" android:textColor="@color/pulse_ink" />
            <RadioButton android:id="@+id/accentOcean" android:layout_width="match_parent" android:layout_height="48dp" android:text="Ocean" android:textColor="@color/pulse_ink" />
            <RadioButton android:id="@+id/accentSunset" android:layout_width="match_parent" android:layout_height="48dp" android:text="Sunset" android:textColor="@color/pulse_ink" />
        </RadioGroup>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="GRADIENT BACKGROUND"
            android:textColor="@color/pulse_lilac"
            android:textSize="12sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/gradientStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/pulse_muted"
            android:textSize="14sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <Button
                android:id="@+id/customizeGradient"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choose palette" />
            <Button
                android:id="@+id/communityThemes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Community themes" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="20dp" android:background="@color/pulse_divider" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MUSIC FOLDERS"
            android:textColor="@color/pulse_lilac"
            android:textSize="12sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Pulse scans these folders in addition to your Android music library."
            android:textColor="@color/pulse_muted"
            android:textSize="14sp" />
        <LinearLayout
            android:id="@+id/folders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />
        <Button
            android:id="@+id/addFolder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Add music folder" />
        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="20dp" android:background="@color/pulse_divider" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="STREAMING MUSIC SERVER" android:textColor="@color/pulse_lilac" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/musicServerStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:textColor="@color/pulse_muted" android:textSize="14sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/connectMusicServer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Connect server" />
            <Button android:id="@+id/disconnectMusicServer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Disconnect" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="20dp" android:background="@color/pulse_divider" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DISCORD RICH PRESENCE" android:textColor="@color/pulse_lilac" android:textSize="12sp" android:textStyle="bold" />
        <Switch
            android:id="@+id/discordPresence"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:text="Share what I am listening to"
            android:textColor="@color/pulse_ink"
            android:thumbTint="@color/discord_switch_thumb_tint"
            android:trackTint="@color/discord_switch_track_tint" />
        <TextView android:id="@+id/cloudflareStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:textColor="@color/pulse_muted" android:textSize="14sp" />
        <Button
            android:id="@+id/enableCloudflareCoverSharing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Enable cover sharing" />
        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="20dp" android:background="@color/pulse_divider" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ABOUT" android:textColor="@color/pulse_lilac" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/version" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="@color/pulse_ink" android:textSize="16sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Open-source local music player" android:textColor="@color/pulse_muted" android:textSize="14sp" />
        <Button
            android:id="@+id/openReleases"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Download latest version" />
        <Button
            android:id="@+id/checkForUpdates"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Check for updates" />
    </LinearLayout>
</ScrollView>
